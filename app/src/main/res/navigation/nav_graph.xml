<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.climasync.view.onboarding.LoginFragment"
        android:label="LoginFragment" >
        <action
            android:id="@+id/action_loginFragment_to_restore_password"
            app:destination="@id/restore_password" />
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
    </fragment>
    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.climasync.view.onboarding.RegisterFragment"
        android:label="fragment_register"
        tools:layout="@layout/fragment_register" >
        <action
            android:id="@+id/action_registerFragment_to_personal_information"
            app:destination="@id/personal_information" />
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>
    <fragment
        android:id="@+id/restore_password"
        android:name="com.example.climasync.view.Restore_password"
        android:label="Restore_password" >
        <action
            android:id="@+id/action_restore_password_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>
    <fragment
        android:id="@+id/personal_information"
        android:name="com.example.climasync.view.onboarding.Personal_information"
        android:label="Personal_information" >
        <action
            android:id="@+id/action_personal_information_to_layoutPermission"
            app:destination="@id/layoutPermission" />
    </fragment>
    <fragment
        android:id="@+id/layoutPermission"
        android:name="com.example.climasync.view.LayoutPermission"
        android:label="LayoutPermission" >
        <action
            android:id="@+id/action_layoutPermission_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>
</navigation>