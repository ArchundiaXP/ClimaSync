<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".view.WeatherFragment">

    <!-- CONTENIDO PRINCIPAL -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Botón de menú -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btMenu"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/menu"
            android:contentDescription="menu bar"
            app:backgroundTint="@color/black"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Ciudad -->
        <TextView
            android:id="@+id/txtNomCiudad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="64dp"
            android:text="Ciudad"
            android:textSize="36sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Día y hora -->
        <TextView
            android:id="@+id/txtDiaHora"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Día y Hora"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/txtNomCiudad"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Imagen del clima -->
        <ImageView
            android:id="@+id/imageView"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/txtDiaHora"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:src="@tools:sample/backgrounds/scenic" />

        <!-- Temperatura actual -->
        <TextView
            android:id="@+id/txtClima"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="23°"
            android:textSize="48sp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/imageView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Saludo -->
        <TextView
            android:id="@+id/txtSaludo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buenos días"
            android:textSize="20sp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/txtClima"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Amanecer -->
        <ImageView
            android:id="@+id/imageView12"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintBottom_toTopOf="@id/textView6"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="16dp"
            app:srcCompat="@drawable/sol" />

        <TextView
            android:id="@+id/textView6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Amanecer"
            android:textSize="14sp"
            app:layout_constraintBottom_toTopOf="@id/txtHoraAmanecer"
            app:layout_constraintStart_toStartOf="@id/imageView12" />

        <TextView
            android:id="@+id/txtHoraAmanecer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="6:00 hrs"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@id/imageView12"
            android:layout_marginBottom="8dp" />

        <!-- Temperatura -->
        <ImageView
            android:id="@+id/imageView11"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintBottom_toTopOf="@id/txtTemp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:srcCompat="@drawable/temperatura" />

        <TextView
            android:id="@+id/txtTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Temperatura"
            app:layout_constraintBottom_toTopOf="@id/txtTemperatura"
            app:layout_constraintStart_toStartOf="@id/imageView11"
            app:layout_constraintEnd_toEndOf="@id/imageView11" />

        <TextView
            android:id="@+id/txtTemperatura"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="23°"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@id/imageView11"
            app:layout_constraintEnd_toEndOf="@id/imageView11"
            android:layout_marginBottom="8dp" />

        <!-- Viento -->
        <ImageView
            android:id="@+id/imageView10"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintBottom_toTopOf="@id/txtVient"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="16dp"
            app:srcCompat="@drawable/aire" />

        <TextView
            android:id="@+id/txtVient"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Viento"
            app:layout_constraintBottom_toTopOf="@id/txtVelocidadV"
            app:layout_constraintEnd_toEndOf="@id/imageView10" />

        <TextView
            android:id="@+id/txtVelocidadV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4 m/s"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/imageView10" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- MENU LATERAL -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:menu="@menu/menu_drawer"
        app:headerLayout="@layout/nav_header" />
</androidx.drawerlayout.widget.DrawerLayout>
